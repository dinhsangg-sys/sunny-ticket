# Reference only. Adapt to the existing reverse proxy; do not overwrite sn's config.
# This example assumes Nginx and Django run on the SAME Ubuntu host.
server {
    listen 80;
    server_name souvenirs.hoianmemorieslands.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name souvenirs.hoianmemorieslands.com;
    ssl_certificate /etc/letsencrypt/live/souvenirs.hoianmemorieslands.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/souvenirs.hoianmemorieslands.com/privkey.pem;
    client_max_body_size 128m;
    location /static/ { alias /home/sunny-ticket/sunny_server/staticfiles/; }
    # Keep media behind Django's published-product checks; no public MEDIA_ROOT alias.
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://127.0.0.1:8000;
    }
}
