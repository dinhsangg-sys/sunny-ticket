# Merge these lines into the SAME environment loaded by the running app.
# Keep all existing SePay secrets, SMTP settings and database configuration.
PUBLIC_SITE_URL=https://sunnygovn.com
PUBLIC_SITE_HOSTS=sunnygovn.com,www.sunnygovn.com
DJANGO_ALLOWED_HOSTS=sunnygovn.com,www.sunnygovn.com,sn.hoianmemorieslands.com,172.16.150.157,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sunnygovn.com,https://www.sunnygovn.com,https://sn.hoianmemorieslands.com
# Set a real active superuser username. Not a password or SePay account.
ONLINE_PAYMENT_OWNER=REPLACE_WITH_EXISTING_SUPERUSER_USERNAME
# Enable only after verified TEST checkout, email and public HTTPS.
ONLINE_CHECKOUT_ENABLED=0
# Switch printed product links only after the new domain is working:
# SOUVENIRS_CATALOG_URL=https://sunnygovn.com/souvenirs/catalog/
